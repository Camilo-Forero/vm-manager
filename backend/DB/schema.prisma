generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("client") // "admin" or "client"
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model VM {
  id        Int      @id @default(autoincrement())
  name      String
  cores     Int
  ram       Int      // in GB
  disk      Int      // in GB
  os        String
  status    String   @default("inactive") // "active" or "inactive"
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("vms")
}
